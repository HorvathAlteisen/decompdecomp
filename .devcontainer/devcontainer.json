{
  "name": "decompdecomp",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",
  // bubblewrap (the sandbox for compiles, see Dockerfile) makes user namespaces. The default seccomp and AppArmor
  // profiles of Docker block user namespaces. The first two options remove the two profiles from this container.
  // bubblewrap also mounts a new /proc for each compile. Docker covers some paths in /proc of the container
  // (for example /proc/kcore and /proc/sys). While these paths are covered, the kernel does not let bubblewrap
  // mount a new /proc. The error is "bwrap: Can't mount proc on /proc: Operation not permitted", and each
  // compile fails. "systempaths=unconfined" removes these covers. Use this container only on your own computer.
  "runArgs": ["--security-opt", "seccomp=unconfined", "--security-opt", "apparmor=unconfined",
              "--security-opt", "systempaths=unconfined"],
  "updateRemoteUserUID": true,
  // The app's window shows on the Windows desktop through WSLg. The variables and the two WSLg mounts follow
  // microsoft/wslg's samples/container/Containers.md. Docker Desktop (WSL2 backend) offers WSLg's folder at
  // /run/desktop/mnt/host/wslg. If the container does not start because these mounts fail, remove the two WSLg
  // mounts and the three display variables, and set "DECOMP_WEB": "1": `uv run decomp` then starts the web mode and
  // prints a login link. DECOMP_TRAY: a container has no tray.
  "containerEnv": {
    "DISPLAY": ":0",
    "WAYLAND_DISPLAY": "wayland-0",
    "XDG_RUNTIME_DIR": "/mnt/wslg/runtime-dir",
    "DECOMP_TRAY": "0"
  },
  // projects and the installed compilers outlive a rebuild of the container; the last two mounts are WSLg (above)
  "mounts": [
    "source=decompdecomp-projects,target=/home/vscode/Decomp-dev,type=volume",
    "source=decompdecomp-toolchains,target=/home/vscode/.local/share/decompnet,type=volume",
    "source=/run/desktop/mnt/host/wslg/.X11-unix,target=/tmp/.X11-unix,type=bind",
    "source=/run/desktop/mnt/host/wslg,target=/mnt/wslg,type=bind"
  ],
  "postCreateCommand": "uv sync",
  // a checkout is the development copy: port 6474 (app/edition.py). VS Code tunnels it; nothing is published.
  "forwardPorts": [6474],
  "portsAttributes": { "6474": { "label": "decompdecomp", "onAutoForward": "silent" } },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"],
      "settings": { "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python" }
    }
  }
}
